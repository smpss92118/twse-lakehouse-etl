# Copy to .env (or run `make env`, which generates the secrets). .env is gitignored.
AIRFLOW_UID=501
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_FERNET_KEY=
# twse = live TWSE API, fixture = recorded payloads in fixtures/ (offline / rate-limited)
TWSE_SOURCE=twse
# Enables the LLM unscheduled-closure check. Without it a no-data trading day fails closed (alert).
# ANTHROPIC_API_KEY=
# HOLIDAY_LLM_MODEL=claude-sonnet-5-5
# HOLIDAY_LLM_CMD=python -m twse_etl.holiday_llm
